<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros2_http_gateway</name>
  <!-- Mirrors [project] version in pyproject.toml, which is the single source of truth.
       test/test_packaging.py fails the build if the two ever drift. -->
  <version>0.2.1</version>
  <description>Config-driven, authenticated HTTP + SSE gateway for ROS 2</description>
  <maintainer email="mail@saifsidhik.page">Saif Sidhik</maintainer>
  <license>Apache-2.0</license>

  <url type="repository">https://github.com/justagist/ros2_http_gateway</url>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-jsonschema</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>std_msgs</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>sensor_msgs</test_depend>
  <test_depend>diagnostic_msgs</test_depend>
  <!-- test_msgs carries the field-kind battery and the golden files; example_interfaces
       and std_srvs are used by both shipped example configs. -->
  <test_depend>test_msgs</test_depend>
  <test_depend>example_interfaces</test_depend>
  <test_depend>std_srvs</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
